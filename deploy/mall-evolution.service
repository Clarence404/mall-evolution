# 阶段一遗留：只对应 stage-1-monolith 标签（那时只有 mall-app 一个进程、部署在云主机上），main 上不再维护；阶段三起改为 Kubernetes，见 deploy/k8s
# /etc/systemd/system/mall-evolution.service
[Unit]
Description=mall-evolution (mall-app)
After=network-online.target
Wants=network-online.target

[Service]
User=mall
Group=mall
WorkingDirectory=/opt/mall-evolution
# 端口：8080 业务（挂负载均衡），18080 管理（健康检查与 Prometheus 抓指标，只对内网监控开放，可用 MANAGEMENT_PORT 改）
# 数据库密码等密钥只放在这个文件里：权限 600，只有部署账号可读
EnvironmentFile=/etc/mall-evolution/env
ExecStart=/usr/bin/java -Xms4g -Xmx4g -XX:+UseG1GC -jar /opt/mall-evolution/mall-app.jar --spring.profiles.active=prod
SuccessExitStatus=143
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
