{
  "title": "示例商城 · JVM 与 HTTP",
  "uid": "mall-jvm-http",
  "description": "mall-evolution 四个服务的通用指标：按「服务」下拉切换；数据来自各服务管理端口的 /actuator/prometheus，按 app 标签（本地 file_sd 与 k8s PodMonitor 都会打）圈定四个服务",
  "tags": [
    "mall",
    "jvm",
    "http"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "数据源",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "app",
        "label": "服务",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(jvm_info{app=~\"mall-app|inventory-service|payment-service|mall-gateway\"}, app)",
          "refId": "A"
        },
        "definition": "label_values(jvm_info{app=~\"mall-app|inventory-service|payment-service|mall-gateway\"}, app)",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "mall-app",
          "value": "mall-app"
        }
      },
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(jvm_info{app=\"$app\"}, instance)",
          "refId": "B"
        },
        "definition": "label_values(jvm_info{app=\"$app\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "概况（四个服务）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "抓取状态",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{app=~\"mall-app|inventory-service|payment-service|mall-gateway\"}",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "1 = Prometheus 能从管理端口抓到指标；0 = 进程没起或管理端口不通"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "每秒请求数（按服务）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{app=~\"mall-app|inventory-service|payment-service|mall-gateway\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "运行时长",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "process_uptime_seconds{app=~\"mall-app|inventory-service|payment-service|mall-gateway\"}",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "HTTP（$app）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "每秒请求数（按接口）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{app=\"$app\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "状态码分布",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{app=\"$app\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "平均耗时（按接口）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{app=\"$app\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{app=\"$app\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "只配了 800ms 一个 SLO 桶（网关没配），算不出可靠的 P99，所以看平均值和最大值"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "最大耗时（按接口，近一个统计窗口）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (method, uri) (http_server_requests_seconds_max{app=\"$app\",instance=~\"$instance\",uri!~\"/actuator.*\"})",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "5xx 占比",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{app=\"$app\",instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"$app\",instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "没有 5xx 时分子是空向量，补 or vector(0) 让面板显示 0 而不是 No data"
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "800ms 内完成的占比（mall-app / 库存 / 支付）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_server_requests_seconds_bucket{app=\"$app\",instance=~\"$instance\",le=\"0.8\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"$app\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "≤ 800ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "来自 management.metrics.distribution.slo 生成的 le=0.8 桶；网关没配这个桶，选网关时为空"
    },
    {
      "id": 12,
      "type": "row",
      "title": "网关路由（mall-gateway）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "每秒请求数（按路由）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{app=\"mall-gateway\"}[$__rate_interval]))",
          "legendFormat": "{{routeId}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "网关的 http_server_requests 里 uri 都是 UNKNOWN，按路由看用 Spring Cloud Gateway 自己的 spring_cloud_gateway_requests"
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "平均耗时（按路由，含下游）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_sum{app=\"mall-gateway\"}[$__rate_interval])) / clamp_min(sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{app=\"mall-gateway\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{routeId}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "JVM（$app）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "堆内存",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (jvm_memory_used_bytes{app=\"$app\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "已用 {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (jvm_memory_committed_bytes{app=\"$app\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "已提交 {{instance}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (jvm_memory_max_bytes{app=\"$app\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "上限 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "非堆内存（按区域）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (id) (jvm_memory_used_bytes{app=\"$app\",instance=~\"$instance\",area=\"nonheap\"})",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "GC 停顿（每秒累计停顿时长）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{app=\"$app\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{action}} / {{cause}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "CPU 使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "process_cpu_usage{app=\"$app\",instance=~\"$instance\"}",
          "legendFormat": "进程 {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "system_cpu_usage{app=\"$app\",instance=~\"$instance\"}",
          "legendFormat": "整机 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "线程",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "jvm_threads_live_threads{app=\"$app\",instance=~\"$instance\"}",
          "legendFormat": "存活"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "jvm_threads_peak_threads{app=\"$app\",instance=~\"$instance\"}",
          "legendFormat": "峰值"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "jvm_threads_daemon_threads{app=\"$app\",instance=~\"$instance\"}",
          "legendFormat": "守护"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "已加载类 / 日志事件",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "jvm_classes_loaded_classes{app=\"$app\",instance=~\"$instance\"}",
          "legendFormat": "已加载类"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (level) (rate(logback_events_total{app=\"$app\",instance=~\"$instance\",level=~\"warn|error\"}[$__rate_interval]))",
          "legendFormat": "日志 {{level}} /s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 22,
      "type": "row",
      "title": "数据库连接池（$app，网关没有）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "HikariCP 连接",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
