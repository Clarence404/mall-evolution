<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.clarence404.mall</groupId>
        <artifactId>mall-evolution</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>bench</artifactId>
    <description>微基准：用 JMH 量业务代码里几段纯 CPU 逻辑的单次耗时与分配。随 ./mvnw verify 只编译不运行，运行见 experiments/l-jmh/run.ps1</description>

    <properties>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <!-- 被测的就是订单模块（以及它带进来的 mall-common）里的类；基准类放在和被测类相同的包名下，好直接调包内可见的方法 -->
        <dependency>
            <groupId>io.github.clarence404.mall</groupId>
            <artifactId>mall-order</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JMH 靠注解处理器在编译期生成真正执行的基准代码和 META-INF/BenchmarkList；父 POM 的处理器（Lombok 等）之外再加上它 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- JMH 生成的代码（jmh_generated 包）不是手写的，不按项目的规范查 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <excludes>**/jmh_generated/**/*</excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
