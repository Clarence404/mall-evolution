{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "local"
    }
  ],
  "paths": {
    "/api/admin/products/{skuId}": {
      "put": {
        "tags": [
          "product-admin-controller"
        ],
        "operationId": "adminUpdateProduct",
        "parameters": [
          {
            "name": "skuId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "order-query-controller"
        ],
        "operationId": "listMyOrders",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING_PAYMENT",
                "PENDING_SHIPMENT",
                "SHIPPED",
                "COMPLETED",
                "CANCELLED",
                "CLOSED"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CursorResultOrderListItemView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "place-order-controller"
        ],
        "operationId": "placeOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "minLength": 16
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{orderNo}/cancel": {
      "post": {
        "tags": [
          "cancel-order-controller"
        ],
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "orderNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已取消",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "409": {
            "description": "当前状态不能取消（ORDER_STATUS_CONFLICT）",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "refreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/products/{skuId}/cache-evict": {
      "post": {
        "tags": [
          "product-admin-controller"
        ],
        "operationId": "adminEvictProductCache",
        "parameters": [
          {
            "name": "skuId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/orders/{orderNo}/address": {
      "patch": {
        "tags": [
          "order-address-controller"
        ],
        "operationId": "changeOrderAddress",
        "parameters": [
          {
            "name": "orderNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{skuId}": {
      "get": {
        "tags": [
          "product-detail-controller"
        ],
        "operationId": "getProductDetail",
        "parameters": [
          {
            "name": "skuId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetailPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{orderNo}": {
      "get": {
        "tags": [
          "order-query-controller"
        ],
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          "price": {
            "type": "number",
            "minimum": 0.01
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "maximum": 1,
            "minimum": 0
          }
        }
      },
      "AddressForm": {
        "type": "object",
        "properties": {
          "receiver": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "pattern": "1\\d{10}"
          },
          "detail": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "detail",
          "phone",
          "receiver"
        ]
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "skuId": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "maximum": 99,
            "minimum": 1
          }
        },
        "required": [
          "quantity",
          "skuId"
        ]
      },
      "PlaceOrderRequest": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "maxItems": 50,
            "minItems": 0
          },
          "address": {
            "$ref": "#/components/schemas/AddressForm"
          },
          "remark": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "address",
          "lines"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "skuId": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "productImage": {
            "type": "string"
          },
          "unitPrice": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "itemAmount": {
            "type": "string"
          }
        }
      },
      "OrderView": {
        "type": "object",
        "properties": {
          "orderNo": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "totalAmount": {
            "type": "string"
          },
          "freightAmount": {
            "type": "string"
          },
          "discountAmount": {
            "type": "string"
          },
          "payAmount": {
            "type": "string"
          },
          "receiver": {
            "$ref": "#/components/schemas/Receiver"
          },
          "remark": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Receiver": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "password",
          "phone"
        ]
      },
      "ProductDetailPage": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/ProductDetailView"
          },
          "inStock": {
            "type": "boolean"
          }
        }
      },
      "ProductDetailView": {
        "type": "object",
        "properties": {
          "skuId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "onShelf": {
            "type": "boolean"
          }
        }
      },
      "CursorResultOrderListItemView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderListItemView"
            }
          },
          "nextCursor": {
            "type": "string"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "OrderListItemView": {
        "type": "object",
        "properties": {
          "orderNo": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "payAmount": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
